{
  "name": "@profireaper/neural-cli",
  "version": "0.2.0",
  "description": "Streaming command-line interface for your Neural Guide Sync AI brain — chat with tool trace, live tail, schedule prompts, and trigger jobs from your terminal.",
  "bin": {
    "neural": "./bin/neural.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/neural.mjs",
    "release": "node ./scripts/release.mjs",
    "publish:beta": "npm publish --access public --tag beta",
    "publish:latest": "npm publish --access public"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "streaming",
    "tool-calling",
    "zoho",
    "github",
    "perplexity",
    "cloudflare",
    "supabase",
    "lovable"
  ],
  "license": "MIT",
  "author": "ProFireaper",
  "homepage": "https://neural-guide-sync.lovable.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProFireaper/neural-guide-sync.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/ProFireaper/neural-guide-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
